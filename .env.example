# ═══════════════════════════════════════════
# DevAgent CLI — Configuración
# ═══════════════════════════════════════════
# Copy this file as .env and fill in the values

# Active LLM provider: openrouter | ollama | openai | gemini
DEVAGENT_PROVIDER=openrouter

# Model to use (if empty, use the provider default)
DEVAGENT_MODEL=google/gemma-4-31b-it:free

# ── OpenRouter (free models available) ─
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# ── OpenAI ──────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# ── Google Gemini / Vertex AI ───────────────
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxx

# ── Ollama (local, without API key) ─────
OLLAMA_HOST=http://localhost:11434

# ── Qdrant (vector store for RAG) ──────────
QDRANT_HOST=localhost
QDRANT_PORT=6334

# ── MCP Server ──────────────────────────────
MCP_PORT=3000
